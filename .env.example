# Copy to .env and adjust. Every value here is optional.

# --- Price source -----------------------------------------------------------
# "fixture" runs fully offline with deterministic demo data.
# "pokemontcgio" tracks real TCGplayer market prices.
PRICE_PROVIDER=fixture
# POKEMONTCG_API_KEY=your-key-here

# --- Server -----------------------------------------------------------------
PORT=4000
DATABASE_PATH=./data/pokedex.db
PRICE_REFRESH_MINUTES=60

# --- Swing detection --------------------------------------------------------
# Windows tracked, in hours. The first is the default the UI shows.
SWING_WINDOWS=24,168
# Minimum magnitude that alerts for cards you own: minor|notable|major|extreme
NOTIFY_AT_OR_ABOVE=major
# Moves smaller than this many cents never alert, whatever the percentage.
SWING_FLOOR_CENTS=50
# Suppress repeat alerts for the same card for this long.
ALERT_COOLDOWN_HOURS=12
# Also push for cards you do NOT own (they always appear in the Movers tab).
NOTIFY_ON_MARKET_MOVERS=false

# --- Optional server-side OCR ----------------------------------------------
# Directory holding eng.traineddata. Without it, clients post recognized text.
# TESSDATA_PATH=/usr/share/tessdata

# --- App --------------------------------------------------------------------
# Baked into the bundle at build time. Leave unset in Expo dev: the app derives
# the API address from the dev server, which is what makes a physical phone work.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# --- Deployment -------------------------------------------------------------
# Shared secret required on every /api route. Optional locally; the server
# REFUSES TO START in production without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_TOKEN=

# Exported web build to serve alongside the API (single-host deployment).
# Auto-detected from ../app/dist and ./web when unset.
# WEB_ROOT=/app/web
